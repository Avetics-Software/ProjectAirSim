{
  "$schema": "../../../projectairsim/src/projectairsim/schema/scene_config_schema.jsonc",
  "id": "SceneArduX8Plane",
  "actors": [
    {
      "type": "robot",
      "name": "X8",
      // Airborne spawn: the robot config holds the X8 here on a virtual
      // catapult until ArduPlane launches it.
      "origin": {
        "xyz": "0 0 -120",
        "rpy": "0 0 0"
      },
      "start-landed": false,
      "robot-config": "robot_ardu_x8_plane.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 4000000,
    "real-time-update-rate": 4000000,
    "pause-on-start": false
  },
  // ArduPilot reports positions from this point, so start SITL with
  // --home=29.4296741,-95.16384722,7.5,0 (see ardupilot_x8_plane.py).
  "home-geo-point": {
    "latitude": 29.4296741,
    "longitude": -95.16384722,
    "altitude": 7.5
  },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
