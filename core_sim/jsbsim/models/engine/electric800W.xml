<electric_engine name="electric">
 <!-- This is a basic model of the electric motor used to power the x8
 -->
 <!-- x8.xml pairs this engine with a "direct" thruster, which uses the engine
      output (ft*lbf/s) as thrust in lbf. This is therefore a thrust setting,
      not the motor's 800 W rating: 8 W gives about 5.9 lbf (26 N) of static
      thrust at full throttle, as in the upstream model. 800 W gave 590 lbf,
      about 80 g on the 3.4 kg airframe. -->
 <power unit="WATTS">  8.0 </power>
</electric_engine>
