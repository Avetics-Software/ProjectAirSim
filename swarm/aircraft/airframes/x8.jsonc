// Skywalker X8 flying wing on JSBSim, flown by ArduPlane (aircraft/models.yml
// x8_arduplane). Its tuned ArduPlane parameters are params/x8_arduplane.param.
{
  // The airframe matches Project AirSim's JSBSim X8 example (robot_x8_jsbsim.jsonc);
  // only the controller and the actuators that feed JSBSim differ.
  "physics-type": "jsbsim-physics",
  // Ground height from the Unreal terrain (Cesium tiles) under the aircraft
  "jsbsim-ground-mode": "terrain",
  "jsbsim-root-path": "/SimLibs/core_sim/jsbsim/models/",
  "jsbsim-aircraft-path": "aircraft",
  "jsbsim-engine-path": "engine",
  "jsbsim-systems-path": "systems",
  "jsbsim-model": "x8",
  "jsbsim-dt": 0.004,
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 3.364,
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.82 2.10 0.18"
            }
          }
        }
      },
      "collision": {
        "enabled": true,
        "restitution": 0.1,
        "friction": 0.5
      },
      "visual": {
        "origin": {
          // The body orientation is baked into X8_Wing_Body.
          "xyz": "0 0 0",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/X8/X8_Wing_Body"
        }
      }
    },
    {
      "name": "Prop",
      "inertial": {
        "mass": 0.01,
        "inertia": {
          "type": "point-mass"
        }
      },
      "visual": {
        "origin": {
          // Exact relative rotation measured in Unreal. Project AirSim rpy is
          // roll/pitch/yaw; yaw keeps its sign in the NED-to-Unreal mapping.
          "xyz": "0 0 0",
          "rpy-deg": "0 0 -90"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/X8/X8_Propeller"
        }
      }
    },
    {
      // Anchors for the control-surface actuators. The X8 mesh has its elevons
      // baked in, so these links carry no visual.
      "name": "Aileron",
      "inertial": {
        "origin": {
          "xyz": "-0.35 0.0 0.0",
          "rpy": "0 0 0"
        },
        "mass": 0.001,
        "inertia": {
          "type": "point-mass"
        }
      }
    },
    {
      "name": "Elevator",
      "inertial": {
        "origin": {
          "xyz": "-0.35 0.0 0.0",
          "rpy": "0 0 0"
        },
        "mass": 0.001,
        "inertia": {
          "type": "point-mass"
        }
      }
    }
  ],
  "joints": [
    {
      "id": "Frame_Prop",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop",
      "axis": "1 0 0",
      "origin": {
        // Hub position measured in Unreal after centering the propeller pivot.
        // UE centimetres/NEU (-32.069071, -0.000001, -2.166665) -> metres/NED.
        "xyz": "-0.32069071 -0.00000001 0.02166665",
        "rpy": "0 0 0"
      }
    },
    {
      "id": "Frame_Aileron",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Aileron",
      "axis": "0 1 0"
    },
    {
      "id": "Frame_Elevator",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Elevator",
      "axis": "0 1 0"
    }
  ],
  // No "controller": aircraft.py builds it from the autopilot's link settings
  // (aircraft/models.yml) plus what this airframe needs from each family.
  "autopilot": {
    "ardupilot": {
      "controller": {
        "airframe-setup": "fixed-wing"
      },
      "settings": {
        // Once connected, how long each tick waits for ArduPilot's next frame
        "frame-timeout-ms": 1000,
        "send-airspeed": true,
        // The X8 has no landing gear: it is held at the runway spawn on a
        // virtual catapult and launched when ArduPlane's TAKEOFF applies
        // throttle (docs/controllers/ardupilot.md)
        "launch": {
          "hold": true,
          "release-throttle": 0.5,
          "speed": 18.0,
          "duration": 0.5
        }
      },
      // One entry per ArduPilot servo output: index 0 is SERVO1, as in
      // params/x8_arduplane.param (SERVO1 aileron, SERVO2 elevator, SERVO3 throttle)
      "actuator-order": [
        {
          "id": "Aileron_actuator"
        },
        {
          // ArduPilot's positive elevator is nose-up; JSBSim's is nose-down
          "id": "Elevator_actuator",
          "scale": -1.0
        },
        {
          "id": "Throttle_actuator"
        }
      ]
    }
  },
  // Belly camera just ahead of the centre of gravity, looking 45 deg down
  "gimbal-mount": {
    "parent-link": "Frame",
    "child-link": "Prop",
    "origin": {
      "xyz": "0.25 0.0 0.08",
      "rpy-deg": "0 -45 0"
    }
  },
  "actuators": [
    {
      "name": "Throttle_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop",
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "1 0 0",
        "coeff-of-thrust": 0.0,
        "coeff-of-torque": 0.0,
        "max-rpm": 9000,
        "propeller-diameter": 0.305,
        "smoothing-tc": 0.001,
        "jsbsim-cmd": "fcs/throttle-cmd-norm",
        "jsbsim-state": "fcs/throttle-cmd-norm"
      }
    },
    {
      // The X8 model mixes these virtual aileron/elevator commands onto its
      // elevons, so ArduPlane runs as a conventional airframe without rudder.
      "name": "Aileron_actuator",
      "type": "lift-drag-control-surface",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Aileron",
      "lift-drag-control-surface-settings": {
        "rotation-rate": 1.0,
        "smoothing-tc": 0.02,
        "jsbsim-cmd": "fcs/aileron-cmd-norm",
        "jsbsim-state": "fcs/effective-aileron-pos"
      }
    },
    {
      "name": "Elevator_actuator",
      "type": "lift-drag-control-surface",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Elevator",
      "lift-drag-control-surface-settings": {
        "rotation-rate": 1.0,
        "smoothing-tc": 0.02,
        "jsbsim-cmd": "fcs/elevator-cmd-norm",
        "jsbsim-state": "fcs/elevator-pos-rad"
      }
    }
  ],
  "sensors": [
    {
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.033333,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 1280,
          "height": 720,
          "fov-degrees": 75,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.2
        }
      ],
      "gimbal": {
        "lock-roll": true,
        "lock-pitch": true,
        "lock-yaw": false
      },
      "origin": {
        "xyz": "-18.0 -6.5 -22.0",
        "rpy-deg": "0 -45 0"
      }
    },
    {
      "id": "Airspeed",
      "type": "airspeed",
      "enabled": true,
      "parent-link": "Frame",
      "forward-xyz": "1 0 0"
    },
    {
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 2.353e-3,
        "tau": 800,
        "bias-stability": 3.53e-4,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 8.72644e-5,
        "tau": 500,
        "bias-stability": 2.23014e-5,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      "id": "GPS",
      "type": "gps",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      "id": "Barometer",
      "type": "barometer",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": true,
      "parent-link": "Frame"
    }
  ]
}
