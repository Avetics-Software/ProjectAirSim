# ArduPlane parameters for the Skywalker X8 (aircraft/models.yml x8_arduplane),
# applied after ArduPilot's stock SITL plane.parm and before the swarm's own
# arduplane_swarm.parm. The aircraft's tuning lives here and only here.

# Servo outputs, in the order of the actuator-order in airframes/x8.jsonc.
# The X8 JSBSim model mixes aileron and elevator onto its elevons, so ArduPlane flies it as a
# conventional airframe without a rudder.
SERVO1_FUNCTION 4
SERVO2_FUNCTION 19
SERVO3_FUNCTION 70
SERVO4_FUNCTION 0

# Catapult launch: in TAKEOFF mode ArduPlane applies takeoff throttle as soon as it is armed,
# which releases the virtual catapult in Project AirSim.
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY 0
TKOFF_ALT 50
# Full throttle climbs past AIRSPEED_MAX and overshoots TKOFF_ALT by ~17 m; 70% keeps it to ~10 m.
TKOFF_THR_MAX 70

# Attitude control uses ArduPlane's default SITL plane gains (Tools/autotest/models/plane.parm).
# On this model they give roll steps a 90% rise time of 0.7-1.0 s and pitch steps 0.4-0.6 s,
# and hold a loiter bank to within 0.2 deg RMS. Two AUTOTUNE passes made roll ~0.2 s quicker
# but pitch about four times slower, so no tuned gains are included.

# X8 speed envelope (m/s): cruise about 18, stall about 12. ArduPilot 4.5+ names.
AIRSPEED_CRUISE 18
AIRSPEED_MIN 13
AIRSPEED_MAX 28

# Loiter radius (m): wide enough that a held point's circle keeps a target near
# its centre in the camera's view (stock SITL plane: 80). models.yml's
# loiter_radius_m must match: the swarm plans with it.
WP_LOITER_RAD 150
